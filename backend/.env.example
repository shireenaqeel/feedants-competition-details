# ---- Server ----
PORT=4000
NODE_ENV=development
# Comma-separated origins allowed by CORS (* for any, fine in development)
CORS_ORIGIN=*
# Public URL of this API for links to uploaded files. Leave empty in development:
# links then use whatever host the client called (works for phones on your Wi-Fi).
PUBLIC_BASE_URL=
# Web URL used in referral links
APP_URL=https://feedants.com

# ---- Database ----
# replicaSet=rs0 is required: spot booking uses multi-document transactions.
MONGODB_URI=mongodb://localhost:27017/feedants?replicaSet=rs0

# ---- Auth ----
# Any long random string in development. Generate one with: openssl rand -hex 32
JWT_SECRET=dev-only-change-me-7f3a9c2e5b8d4f1a
JWT_EXPIRES_IN=7d

# ---- Registration ----
# How long a spot is held while the user completes payment
REGISTRATION_HOLD_MINUTES=10
# How often abandoned holds are released
HOLD_SWEEP_INTERVAL_MS=30000

# ---- Payments ----
# mock = local simulated checkout (no keys needed); razorpay = real Razorpay test/live keys
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Demo data ----
# true: on first start against an empty database, load default competitions (past, ongoing,
# upcoming, cancelled; dates relative to that moment) + demo users.
# Never touches a database that already has competitions. `npm run seed` resets it anytime.
SEED_DEMO_DATA=true

# ---- Uploads ----
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=100
